#include <stdio.h>
int main() {
    int MAX_EMPLOYEES=100, NAME_LEN=50;
    char name[MAX_EMPLOYEES][NAME_LEN];
    float basicPay[MAX_EMPLOYEES], grossSalary;
    int n;

    printf("Enter number of employees (max 100): ");
    scanf("%d", &n);

    if (n > MAX_EMPLOYEES || n <= 0) {
        printf("Invalid number of employees.\n");
        return 1;
    }

    for (int i = 0; i < n; i++) {
        printf("Enter name of employee %d: ", i + 1);
        scanf("%s", name[i]);

        printf("Enter basic pay of %s: ", name[i]);
        scanf("%f", &basicPay[i]);
    }

    printf("\nEmployee Name\tGross Salary\n");
    for (int i = 0; i < n; i++) {
        grossSalary = basicPay[i] + 0.52f * basicPay[i];
        printf("%s\t\t%.2f\n", name[i], grossSalary);
    }

    return 0;
}
