#include <stdio.h>

int main() {
    char name[50];
    int age;

    // Prompt user for name
    printf("Enter your name: ");
    fgets(name, sizeof(name), stdin);  // Reads a line of text including spaces

    // Prompt user for age
    printf("Enter your age: ");
    scanf("%d", &age);

    // Display the input
    printf("Hello, %sYou are %d years old.\n", name, age);

    return 0;
}
