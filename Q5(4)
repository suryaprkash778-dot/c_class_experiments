#include <stdio.h> 

int main() 
{
    int A[10][10], B[10][10], C[10][10]; // Matrices A, B, and result matrix C
    int m, n, p, q, i, j, k; // Dimensions and loop counters

    // Input dimensions of Matrix A
    printf("Enter rows and columns of A: ");
    scanf("%d %d", &m, &n); // m = rows of A, n = columns of A

    // Input dimensions of Matrix B
    printf("Enter rows and columns of B: ");
    scanf("%d %d", &p, &q); // p = rows of B, q = columns of B

    // Check if multiplication is possible (columns of A must equal rows of B)
    if(n != p) 
    {
        printf("Multiplication not possible.\n");
        return 0; // Exit the program if dimensions are incompatible
    }

    // Input elements of Matrix A
    printf("Enter Matrix A:\n");
    for(i = 0; i < m; i++)
        for(j = 0; j < n; j++)
            scanf("%d", &A[i][j]);

    // Input elements of Matrix B
    printf("Enter Matrix B:\n");
    for(i = 0; i < p; i++)
        for(j = 0; j < q; j++)
            scanf("%d", &B[i][j]);

    // Matrix multiplication logic
    for(i = 0; i < m; i++) // Loop over rows of A
        for(j = 0; j < q; j++) // Loop over columns of B
        {
            C[i][j] = 0; // Initialize result cell
            for(k = 0; k < n; k++) // Loop over shared dimension
                C[i][j] += A[i][k] * B[k][j]; // Multiply and add
        }

    // Display the result matrix C
    printf("Resultant Matrix:\n");
    for(i = 0; i < m; i++) 
    {
        for(j = 0; j < q; j++)
            printf("%4d ", C[i][j]); // Print each element with spacing
        printf("\n"); 
    }

    return 0;
}
