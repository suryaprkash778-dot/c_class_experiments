#include <stdio.h>
#include <stdlib.h>
struct Node {
    int data;
    struct Node* next;
};
//function to create a node
struct Node* createNode(int data) {// returns a pointer
    struct Node* newNode = (struct Node*)malloc(sizeof(struct Node));
    if (!newNode) {
        printf("Memory allocation failed\n");
        exit(1);
    }
    newNode->data = data;
    newNode->next = NULL;
    return newNode;
}
// Function to print the linked list
void printList(struct Node* head) {
    struct Node* temp = head;//ponter(temp) to head
    printf("Linked List: ");
    while (temp != NULL) {
        printf("%d -> ", temp->data);
        temp = temp->next;//we are changing the address ofn temp to next, so that we can print next node till null
    }
    printf("NULL\n");
}
int main() {
    // Creating nodes
    struct Node* head = createNode(10);
    struct Node* second = createNode(20);
    struct Node* third = createNode(30);
    // Linking nodes
    head->next = second;
    second->next = third;
    // Print the linked list
    printList(head);
    // Free allocated memory
    free(head);
    free(second);
    free(third);
    return 0;
}
