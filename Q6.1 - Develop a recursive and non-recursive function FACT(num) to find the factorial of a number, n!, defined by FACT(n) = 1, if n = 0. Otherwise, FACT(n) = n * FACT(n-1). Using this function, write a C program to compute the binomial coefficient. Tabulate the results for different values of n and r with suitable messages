#include <stdio.h>
int FACT_recursive(int num) {
    if (num == 0)
        return 1;
    else
        return num * FACT_recursive(num - 1);
}
int FACT_non_recursive(int num) {
    int result = 1;
    for (int i = 1; i <= num; i++)
        result *= i;
    return result;
}

int main() {
    int n, r;
    printf("Enter value of n: ");
    scanf("%d", &n);
    printf("Enter value of r: ");
    scanf("%d", &r);

    if (r > n || n < 0 || r < 0) {
        printf("Invalid input. Ensure that 0 ≤ r ≤ n.\n");
        return 1;
    }
    //uing recurive
    int n_fact1 = FACT_recursive(n);
    int r_fact1 = FACT_recursive(r);
    int n_r_fact1 = FACT_recursive(n - r);
    int binomial_r = n_fact1 / (r_fact1 * n_r_fact1);

    // Using non-recursive 
    int n_fact2 = FACT_non_recursive(n);
    int r_fact2 = FACT_non_recursive(r);
    int n_r_fact2 = FACT_non_recursive(n - r);
    int binomial_nr = n_fact2 / (r_fact2 * n_r_fact2);

    printf("\nBinomial Coefficient C(%d, %d):\n", n, r);
    printf("Recursive Factorial: %d\n", binomial_r);
    printf("Non-Recursive Factorial: %d\n", binomial_nr);

    return 0;
}
